# ─────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─────────────────────────────────────────────
#  DATABASE
#  Get this from MongoDB Atlas → Connect → Drivers
#  Format: mongodb+srv://<user>:<pass>@cluster.mongodb.net/<dbname>
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster.mongodb.net/contacts

# ─────────────────────────────────────────────
#  SMTP / EMAIL
#  Gmail example:
#    SMTP_HOST=smtp.gmail.com
#    SMTP_PORT=587
#    SMTP_USER=you@gmail.com
#    SMTP_PASS=your_app_password   ← Gmail App Password (not your real password)
#
#  Custom SMTP (Mailgun, SendGrid, etc.) same pattern.
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Who the email appears to come from
EMAIL_FROM="Contact Bot <you@gmail.com>"

# Who receives the CSV report
EMAIL_TO=admin@yourcompany.com

# ─────────────────────────────────────────────
#  SCHEDULER
#  Default: 9 AM and 9 PM every day (server timezone)
#  Cron format: minute hour * * *
#  Change to whatever schedule you need — no code change required.
# ─────────────────────────────────────────────
CRON_SCHEDULE=0 9,21 * * *

# ─────────────────────────────────────────────
#  CORS
#  Your frontend's domain (no trailing slash)
#  Multiple origins comma-separated: https://a.com,https://b.com
# ─────────────────────────────────────────────
CORS_ORIGIN=https://yourfrontend.com

# ─────────────────────────────────────────────
#  RATE LIMITING  (requests per window per IP)
# ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
